{
  "name": "race-control-server",
  "version": "1.11.0",
  "description": "Portal web de dirección de carrera para ligas de Assetto Corsa: largada en movimiento, incidentes y sanciones en tiempo real.",
  "private": true,
  "main": "dist/portal/index.js",
  "scripts": {
    "build": "tsc -p . && node scripts/copy-assets.js",
    "start": "node dist/portal/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/portal/index.ts",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "replay": "node dist/sim/replay.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
