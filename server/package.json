{
  "name": "race-control-server",
  "version": "0.2.2",
  "description": "Backend propio de largada en movimiento y penalizaciones en tiempo real para Assetto Corsa.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p . && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "package": "npm run build && node scripts/package.js",
    "replay": "node dist/sim/replay.js"
  },
  "pkg": {
    "assets": [
      "dist/api/public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "@runonflux/nat-upnp": "^1.0.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@yao-pkg/pkg": "^6.23.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
